<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Sửa bài viết</title>
</head>
<body>
  <h1>Sửa bài viết</h1>

  <% if (post) { %>

    <form action="/edit" method="POST">
      <input type="hidden" name="id" value="<%= post.id %>">

      <p>
        <label>Tiêu đề:</label><br>
        <input
          type="text"
          name="title"
          value="<%= post.title %>"
          required
        >
      </p>

      <p>
        <label>Mô tả:</label><br>
        <textarea name="description" rows="5" required><%= post.description %></textarea>
      </p>

      <button type="submit">Cập nhật</button>
    </form>

  <% } else { %>

    <h2>Không tìm thấy bài viết</h2>

  <% } %>

  <p><a href="/news">Quay lại danh sách tin tức</a></p>
</body>
</html>
